---
const projects = [
  {
    name: "InternGate",
    url: "https://github.com/maulasyakur/intern-gate",
    stack: "Spring Boot \u00B7 React \u00B7 TypeScript",
    desc: "Full-stack internship management system with a Java Spring Boot backend and a React/TypeScript frontend, built with a team.",
  },
  {
    name: "mavenwifey",
    url: "https://github.com/maulasyakur/mavenwifey-next",
    stack: "React \u00B7 Supabase \u00B7 Next.js",
    desc: "Full-stack personal website with blog, chat, and portfolio sections.",
  },
  {
    name: "RecruitPro",
    url: "https://github.com/maulasyakur/recruitpro_django",
    stack: "Django \u00B7 Python \u00B7 Tailwind CSS \u00B7 Alpine.js",
    desc: "Full-stack recruitment management system with a Django backend and Tailwind CSS frontend.",
  },
  {
    name: "chat-app",
    url: "https://github.com/maulasyakur/chat-app",
    stack: "React \u00B7 TypeScript \u00B7 PocketBase",
    desc: "Real-time chat application with live messaging via SSE subscriptions, user authentication, and role-based access control.",
  },
  {
    name: "Expense Tracker",
    url: "https://github.com/maulasyakur/expense_tracker",
    stack: "React \u00B7 Tailwind CSS \u00B7 shadcn/ui",
    desc: "Personal finance app for tracking daily spending with breakdowns and monthly trends dashboard.",
  },
  {
    name: "Todo App",
    url: "https://github.com/maulasyakur/todo-app-flask-react",
    stack: "React \u00B7 Flask \u00B7 Python",
    desc: "Full-stack task management app with a React frontend and Python Flask REST API backend.",
  },
];
---

<section id="projects">
  <p class="section-label">Projects</p>
  <div class="projects-grid">
    {projects.map((project) => (
      <div class="project-card">
        <div class="project-top">
          <div class="project-name">{project.name}</div>
          <a href={project.url} target="_blank" rel="noopener" class="project-link" aria-label={`View ${project.name} on GitHub`}><i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
        </div>
        <div class="project-stack">{project.stack}</div>
        <div class="project-desc">{project.desc}</div>
      </div>
    ))}
  </div>
</section>
