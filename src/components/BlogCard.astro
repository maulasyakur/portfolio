---
export interface Props {
  title: string;
  date: Date;
  description: string;
  tags?: string[];
  slug: string;
}

const { title, date, description, tags, slug } = Astro.props;
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={`/blog/${slug}`} class="blog-card">
  <div class="blog-card-date">{formattedDate}</div>
  <div class="blog-card-title">{title}</div>
  <div class="blog-card-desc">{description}</div>
  {tags && tags.length > 0 && (
    <div class="blog-card-tags">
      {tags.map((tag) => (
        <span class="blog-card-tag">{tag}</span>
      ))}
    </div>
  )}
</a>
